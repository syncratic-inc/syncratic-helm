# Copy to online-observability.images.env and fill with real published image refs.
# Prefer immutable digest-pinned refs for online delivery.

GATEWAY_IMAGE=ghcr.io/lukebabs/syncratic/gateway@sha256:replace-with-gateway-digest
FRONTEND_IMAGE=ghcr.io/lukebabs/syncratic/frontend@sha256:replace-with-frontend-digest
HELP_IMAGE=ghcr.io/lukebabs/syncratic/help-service@sha256:replace-with-help-digest
LICENSING_IMAGE=ghcr.io/lukebabs/syncratic/licensing-service@sha256:replace-with-licensing-digest
REGISTRATION_IMAGE=ghcr.io/lukebabs/syncratic/registration-service@sha256:replace-with-registration-digest
